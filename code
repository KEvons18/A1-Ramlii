import java.util.Scanner;

public class App {
    public static void main(String[] args) throws Exception {
        System.out.println("Cinema Booking System");
        Scanner input = new Scanner(System.in);
        double revenue = 0;

        Movie[] movies = new Movie[3];

        while (true) {
            System.out.println("1. List The Movies");
            System.out.println("2. Add/Change Movie");
            System.out.println("3. Book Ticket");
            System.out.println("4. Show Revenue");
            System.out.println("5. Exit");

            int x = input.nextInt();
            if (x == 1) {
                for (int i = 0; i < movies.length; i++) {
                    if (movies[i] == null) {
                        System.out.println((i + 1) + ". [EMPTY] No movie assigned");
                    } else {
                        System.out.println((i + 1) + ". " + movies[i].title + " - Price: " + movies[i].price);
                    }
                }
                System.out.println();
            } else if (x == 2) {
                Movie.updateMovie(movies, input);
            } else if (x == 3) {

                System.out.print("Enter movie number to book: ");
                int movieNumber = input.nextInt() - 1;

               
                if (movies[movieNumber] == null) {
                    System.out.println("This hall has no movie assigned!");
                    continue; 
                }

                
                movies[movieNumber].showSeats();

                System.out.print("Enter row (1-" + movies[movieNumber].seats.length + "): ");
                int row = input.nextInt() - 1;

                System.out.print("Enter column (1-" + movies[movieNumber].seats[0].length + "): ");
                int col = input.nextInt() - 1;

                if (movies[movieNumber].seats[row][col] == 'O') {
                    movies[movieNumber].seats[row][col] = 'X';
                    revenue += movies[movieNumber].price;
                    System.out.println("Seat booked successfully! Ticket price: " + movies[movieNumber].price);
                } else {
                    System.out.println("Sorry, that seat is already booked!");
                }
            } else if (x == 4) {
                System.out.println("Total revenue so far: " + revenue + " EGP");
            }

            else if (x == 5) {
                System.out.print("Good Bye!!");
                break;
            }

        }

    };
}

class Movie {
    String title;
    int price;
    char[][] seats;

    Movie(String title, int price, int rows, int cols) {
        this.title = title;
        this.price = price;
        seats = new char[rows][cols];

        for (int i = 0; i < rows; i++) {
            for (int j = 0; j < cols; j++) {
                seats[i][j] = 'O';
            }
        }
    }

    void showSeats() {
        System.out.println("Seating for " + title + ":");
        for (int r = 0; r < seats.length; r++) {
            for (int c = 0; c < seats[r].length; c++) {
                System.out.print(seats[r][c] + " ");
            }
            System.out.println();
        }
    }

    static void updateMovie(Movie[] movies, Scanner input) {
        System.out.println(" Hall 1 ----> Small\n Hall 2 ----> Medium\n Hall 3 ----> Large");
        System.out.print("Enter hall number to update (1-3): ");
        int hall = input.nextInt();
        input.nextLine();

        if (hall <= 0 || hall > movies.length) {
            System.out.println("Invalid hall!");
            return;
        }

        System.out.print("Enter new movie title: ");
        String newTitle = input.nextLine();

        System.out.print("Enter new ticket price: ");
        int newPrice = input.nextInt();

        int rows, cols;

        if (hall == 1) {
            rows = 5;
            cols = 5;
        } else if (hall == 2) {
            rows = 6;
            cols = 8;
        } else {
            rows = 8;
            cols = 10;
        }

        movies[hall - 1] = new Movie(newTitle, newPrice, rows, cols);

        System.out.println("Movie added/updated successfully!");
    }

}
